// AMPREX demo — operating core schema.
// Money columns are BigInt Rial. Enum values mirror packages/shared.
// Connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  SUPER_ADMIN
  BRANCH_MANAGER
  OPERATOR
  TECHNICIAN
}

enum OrderStatus {
  CREATED
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ON_SITE
  INSTALLING
  COMPLETED
  CANCELLED
}

enum OrderEventKind {
  STATUS
  NOTE
}

enum VehicleType {
  CAR
  MOTORCYCLE
}

enum InstallLocation {
  PARKING
  STREET
  WORKPLACE
}

enum PaymentMethod {
  CASH
  CARD_POS
  CARD_TO_CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum StockMovementType {
  RECEIPT
  RESERVE
  RELEASE
  ISSUE
  ADJUST
  TRANSFER
}

// ───────────────────── Organisation ─────────────────────

model Branch {
  id               String   @id @default(uuid(7)) @db.Uuid
  code             String   @unique
  name             String
  address          String
  phone            String
  /// Tehran municipal districts (1–22) this branch serves; used to route new orders.
  serviceDistricts Int[]
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  users       User[]
  technicians Technician[]
  stock       Stock[]
  movements   StockMovement[]
  orders      Order[]
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Login identifier (mobile number, 09xxxxxxxxx).
  phone        String    @unique
  fullName     String
  passwordHash String
  role         Role
  /// Required for branch-scoped roles; null only for SUPER_ADMIN.
  branchId     String?   @db.Uuid
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  branch      Branch?         @relation(fields: [branchId], references: [id])
  technician  Technician?
  orderEvents OrderEvent[]
  payments    Payment[]       @relation("PaymentReceivedBy")
  movements   StockMovement[]

  @@index([branchId, role])
}

model Technician {
  id               String   @id @default(uuid(7)) @db.Uuid
  branchId         String   @db.Uuid
  /// Login account; a technician without one cannot use /tech.
  userId           String?  @unique @db.Uuid
  fullName         String
  phone            String   @unique
  /// Tehran districts this technician covers; used to suggest assignments.
  serviceDistricts Int[]
  /// Jobs per day (design: «بار امروز ۳ از ۶»).
  dailyCapacity    Int      @default(6)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  branch   Branch    @relation(fields: [branchId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  missions Mission[]

  @@index([branchId, isActive])
}

// ─────────────────────── Catalogue ───────────────────────

model VehicleModel {
  id        String      @id @default(uuid(7)) @db.Uuid
  code      String      @unique
  type      VehicleType @default(CAR)
  make      String
  /// Persian brand shown to customers, e.g. «ایران‌خودرو».
  brandFa   String
  model     String
  /// Persian display name, e.g. «پژو ۲۰۶ تیپ ۲».
  nameFa    String
  /// Factory battery spec (design: «مشخصه کارخانه ۶۰ آمپر · L2»).
  factoryAh Int
  groupSize String
  yearFrom  Int?
  yearTo    Int?
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)

  compatibilities BatteryCompatibility[]
  orders          Order[]
}

model Battery {
  id             String  @id @default(uuid(7)) @db.Uuid
  sku            String  @unique
  brand          String
  nameFa         String
  capacityAh     Int
  coldCrankingA  Int
  voltage        Int     @default(12)
  /// Physical case group (e.g. L2, L3) — informational.
  groupSize      String
  warrantyMonths Int
  /// Line shown under the brand, e.g. «SMF · سیلد».
  series         String
  /// Selling price, Rial.
  priceRial      BigInt
  /// Purchase cost, Rial (gross-profit estimate; never shown to customers or technicians).
  costRial       BigInt
  isActive       Boolean @default(true)

  compatibilities BatteryCompatibility[]
  stock           Stock[]
  movements       StockMovement[]
  orders          Order[]
}

model BatteryCompatibility {
  vehicleModelId     String  @db.Uuid
  batteryId          String  @db.Uuid
  /// Same Ah as the vehicle's factory spec («مطابق مشخصات کارخانه»); otherwise an alternative.
  matchesFactorySpec Boolean @default(false)

  vehicleModel VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  battery      Battery      @relation(fields: [batteryId], references: [id], onDelete: Cascade)

  @@id([vehicleModelId, batteryId])
  @@index([batteryId])
}

// ─────────────────────── Inventory ───────────────────────

/// available = onHand − reserved. Reserve is a single conditional UPDATE:
///   UPDATE "Stock" SET reserved = reserved + 1
///   WHERE "branchId" = $1 AND "batteryId" = $2 AND "onHand" - reserved >= 1
/// 0 rows → 409 OUT_OF_STOCK. A CHECK constraint (migration) keeps 0 ≤ reserved ≤ onHand.
model Stock {
  id           String   @id @default(uuid(7)) @db.Uuid
  branchId     String   @db.Uuid
  batteryId    String   @db.Uuid
  onHand       Int      @default(0)
  reserved     Int      @default(0)
  /// «حد سفارش»: below this many free units the item is flagged «زیر حد سفارش».
  reorderPoint Int      @default(4)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  branch  Branch  @relation(fields: [branchId], references: [id])
  battery Battery @relation(fields: [batteryId], references: [id])

  @@unique([branchId, batteryId])
}

/// Append-only ledger of stock changes (audit + reports).
model StockMovement {
  id          String            @id @default(uuid(7)) @db.Uuid
  branchId    String            @db.Uuid
  batteryId   String            @db.Uuid
  type        StockMovementType
  /// Signed delta applied to onHand (RECEIPT/ISSUE/ADJUST) or reserved (RESERVE/RELEASE).
  quantity    Int
  orderId     String?           @db.Uuid
  actorUserId String?           @db.Uuid
  /// Document number for receipts / transfers (RCV-…, TRF-…); order movements use the order code.
  reference   String?
  note        String?
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)

  branch  Branch  @relation(fields: [branchId], references: [id])
  battery Battery @relation(fields: [batteryId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])
  actor   User?   @relation(fields: [actorUserId], references: [id])

  @@index([branchId, batteryId, createdAt])
  @@index([branchId, createdAt])
  @@index([orderId])
}

// ─────────────────────── Lookups ───────────────────────

/// Sales channel the order came from (website, phone, Instagram, …).
model Channel {
  id        String  @id @default(uuid(7)) @db.Uuid
  code      String  @unique
  nameFa    String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  orders Order[]
}

/// Daily installation time window. Capacity is per branch per day.
model ServiceSlot {
  id        String  @id @default(uuid(7)) @db.Uuid
  code      String  @unique
  label     String
  /// "HH:mm", Tehran local time.
  startTime String
  endTime   String
  capacity  Int
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  orders Order[]
}

// ─────────────────────── Orders ───────────────────────

model Customer {
  id        String   @id @default(uuid(7)) @db.Uuid
  phone     String   @unique
  fullName  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  orders Order[]
}

model Order {
  id             String      @id @default(uuid(7)) @db.Uuid
  /// Internal sequence number.
  number         Int         @unique @default(autoincrement())
  /// Customer-facing tracking code, AMX-<Jalali YYMMDD>-<4 chars>.
  code           String      @unique
  /// Client-supplied Idempotency-Key header of POST /orders.
  idempotencyKey String      @unique
  status         OrderStatus @default(CREATED)

  customerId     String @db.Uuid
  branchId       String @db.Uuid
  channelId      String @db.Uuid
  vehicleModelId String @db.Uuid
  batteryId      String @db.Uuid
  slotId         String @db.Uuid

  /// Installation day (Tehran local date).
  scheduledDate   DateTime        @db.Date
  district        Int
  address         String
  installLocation InstallLocation @default(PARKING)
  latitude        Decimal?        @db.Decimal(9, 6)
  longitude       Decimal?        @db.Decimal(9, 6)
  customerNote    String?
  /// Branch note for the technician («یادداشت شعبه»).
  branchNote      String?

  /// Price estimate assumes an old battery of this Ah is returned (null = no old battery).
  estimatedCoreAh Int?

  // Price snapshot computed by the API (Rial); the UI only displays it.
  // totalRial = batteryPriceRial + installFeeRial − coreCreditRial.
  // coreCreditRial is an estimate until COMPLETED, then set from CoreReturn.creditAppliedRial.
  batteryPriceRial BigInt
  installFeeRial   BigInt
  coreCreditRial   BigInt
  totalRial        BigInt
  /// Snapshot of Battery.costRial at order time (gross profit).
  batteryCostRial  BigInt

  createdById  String?   @db.Uuid
  cancelReason String?
  completedAt  DateTime? @db.Timestamptz(3)
  cancelledAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  customer     Customer        @relation(fields: [customerId], references: [id])
  branch       Branch          @relation(fields: [branchId], references: [id])
  channel      Channel         @relation(fields: [channelId], references: [id])
  vehicleModel VehicleModel    @relation(fields: [vehicleModelId], references: [id])
  battery      Battery         @relation(fields: [batteryId], references: [id])
  slot         ServiceSlot     @relation(fields: [slotId], references: [id])
  mission      Mission?
  coreReturn   CoreReturn?
  payments     Payment[]
  events       OrderEvent[]
  movements    StockMovement[]

  @@index([branchId, status])
  @@index([branchId, scheduledDate, slotId])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([createdAt])
}

/// STATUS rows are written by OrderStateService (every status change and creation);
/// NOTE rows record changes to the branch note.
model OrderEvent {
  id          String         @id @default(uuid(7)) @db.Uuid
  orderId     String         @db.Uuid
  kind        OrderEventKind @default(STATUS)
  fromStatus  OrderStatus?
  toStatus    OrderStatus?
  actorUserId String?        @db.Uuid
  note        String?
  /// Extra context, e.g. { technicianId } on ASSIGNED, { from, to } on NOTE.
  data        Json?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([orderId, createdAt])
  @@index([toStatus, createdAt])
}

/// The technician's job for one order (one active mission per order in this demo).
model Mission {
  id           String @id @default(uuid(7)) @db.Uuid
  orderId      String @unique @db.Uuid
  technicianId String @db.Uuid

  assignedAt  DateTime  @default(now()) @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  departedAt  DateTime? @db.Timestamptz(3)
  arrivedAt   DateTime? @db.Timestamptz(3)
  startedAt   DateTime? @db.Timestamptz(3)
  installedAt DateTime? @db.Timestamptz(3)

  /// Serial printed on the new battery that was installed.
  installedSerial String?
  technicianNote  String?

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  technician Technician @relation(fields: [technicianId], references: [id])

  @@index([technicianId, assignedAt])
}

/// Old-battery (باتری داغی) handover, recorded at «ثبت پایان و تسویه».
model CoreReturn {
  id                String   @id @default(uuid(7)) @db.Uuid
  orderId           String   @unique @db.Uuid
  returned          Boolean
  /// Ah read from the old battery's label; null when not returned.
  ampereHours       Int?
  /// Credit granted = ampereHours × coreCreditPerAhRial, Rial.
  creditAppliedRial BigInt
  /// Estimated scrap value recovered by the company, Rial.
  scrapValueRial    BigInt
  recordedAt        DateTime @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String        @id @default(uuid(7)) @db.Uuid
  orderId      String        @db.Uuid
  /// Amount actually received.
  amountRial   BigInt
  /// Payable at settlement; amountRial ≠ expectedRial is a «مغایرت تسویه».
  expectedRial BigInt
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  /// POS / bank / gateway reference.
  reference    String?
  receivedById String?       @db.Uuid
  paidAt       DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedBy User? @relation("PaymentReceivedBy", fields: [receivedById], references: [id])

  @@index([orderId])
  @@index([status, paidAt])
}

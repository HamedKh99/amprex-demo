# Postgres (docker-compose.yml reads these too)
POSTGRES_USER=amprex
POSTGRES_PASSWORD=amprex_dev_only
POSTGRES_DB=amprex
POSTGRES_PORT=5432

# API (apps/api)
DATABASE_URL=postgresql://amprex:amprex_dev_only@localhost:5432/amprex?schema=public
API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Password set for the 4 seeded demo users (dev only)
SEED_DEMO_PASSWORD=Demo@1405

# Web (apps/web) — Next rewrites /api/* to this origin
API_URL=http://localhost:4000

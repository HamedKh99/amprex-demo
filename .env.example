# Postgres (docker-compose.yml reads these too)
POSTGRES_USER=amprex
POSTGRES_PASSWORD=amprex_dev_only
POSTGRES_DB=amprex
POSTGRES_PORT=5432

# API (apps/api)
DATABASE_URL=postgresql://amprex:amprex_dev_only@localhost:5432/amprex?schema=public
# Optional direct (non-pooled) URL. When set, prisma migrate and the seed use it instead of
# DATABASE_URL; the running API always uses DATABASE_URL. Needed with Neon (DATABASE_URL is pooled).
# DATABASE_URL_UNPOOLED=
API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Password set for the 4 seeded demo users (dev only)
SEED_DEMO_PASSWORD=Demo@1405
# The seed deletes ALL data, so it refuses any non-local database unless this is 1.
# Set it only on the command line for a one-time remote seed, never in a file.
# SEED_ALLOW_REMOTE=1

# Web (apps/web) — Next rewrites /api/* to this origin. Read when `next build` runs, so on a
# host like Vercel it must be set for the build, and changing it needs a rebuild. No trailing /api.
API_URL=http://localhost:4000

# Vercel only (both projects, not needed locally): build with the pnpm version from packageManager
# ENABLE_EXPERIMENTAL_COREPACK=1

{
  "name": "amprex-demo",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @amprex/shared build && pnpm -r --parallel --filter !@amprex/shared dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @amprex/api db:migrate",
    "db:seed": "pnpm --filter @amprex/api db:seed",
    "db:reset": "pnpm --filter @amprex/api db:reset"
  }
}

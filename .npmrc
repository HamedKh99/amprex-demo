save-exact=true
# Real folders in node_modules instead of pnpm's symlinks. Vercel's backend builder traces the API's
# dependencies file by file and loses pnpm's per-package symlinks (e.g. apps/api/node_modules/
# @nestjs/throttler), which broke the deployed function. Hoisted keeps Vercel, CI and local identical.
node-linker=hoisted
